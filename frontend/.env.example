# true = in-browser mock data (no backend needed), false = Spring Boot API
VITE_USE_MOCKS=true
# Copy to frontend/.env.local (git-ignored) and replace the placeholder values.
# WARNING: every VITE_* variable is bundled into the browser. Never put private keys here;
# keep private keys in backend/.env and call them through the API.
VITE_API_BASE_URL=http://localhost:8080/api
VITE_PUSH_VAPID_PUBLIC_KEY=your-vapid-public-key
