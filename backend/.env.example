# Copy to backend/.env (git-ignored) and replace the placeholder values.
# Loaded automatically by application.yml when the backend is started from the backend/ folder.

# --- Database (any PostgreSQL 14+; defaults match docker-compose / a local install) ---
DB_URL=jdbc:postgresql://localhost:5432/disaster
DB_USERNAME=disaster
DB_PASSWORD=change-me
DB_POOL_SIZE=5

# Supabase (session pooler, port 5432 - not the transaction pooler on 6543, Flyway needs session mode):
# DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=<database password from Supabase project settings>

# --- Web ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- SMS gateway (sign-up codes; later the warnings SMS channel) ---
# mock = nothing is sent (the code is logged at DEBUG and shown on screen in dev); textlk = real SMS
SMS_PROVIDER=mock
# Text.lk: https://app.text.lk -> API token. Each real message uses a credit.
SMS_TEXTLK_API_KEY=your-text-lk-api-token
# Sender ID: TextLKDemo works on any account; your own name needs Text.lk approval first
SMS_SENDER_ID=TextLKDemo

# --- Push notifications (warnings: PUSH channel) ---
FCM_SERVER_KEY=your-fcm-server-key

# --- Weather / river gauge feeds (replace the sensor simulator) ---
WEATHER_API_KEY=your-weather-api-key
RIVER_GAUGE_FEED_URL=https://gauges.example.invalid/feed
RIVER_GAUGE_API_KEY=your-river-gauge-api-key

# --- Optional: separate database for `./mvnw verify -Dapp.test.use-testcontainers=false` ---
TEST_DB_URL=jdbc:postgresql://localhost:5432/disaster_test
TEST_DB_USERNAME=disaster
TEST_DB_PASSWORD=change-me

# --- Authentication ---
# Signs the access tokens: at least 32 random characters, different per environment.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
