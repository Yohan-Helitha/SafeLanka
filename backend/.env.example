# Copy to backend/.env (git-ignored) and replace the placeholder values.
# Loaded automatically by application.yml when the backend is started from the backend/ folder.

# --- Database (any PostgreSQL 14+; defaults match docker-compose / a local install) ---
DB_URL=jdbc:postgresql://localhost:5432/disaster
DB_USERNAME=disaster
DB_PASSWORD=change-me

# --- Web ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- SMS gateway (warnings: SMS channel) ---
SMS_GATEWAY_URL=https://sms.example.invalid/api
SMS_GATEWAY_API_KEY=your-sms-api-key
SMS_SENDER_ID=SafeLanka

# --- Push notifications (warnings: PUSH channel) ---
FCM_SERVER_KEY=your-fcm-server-key

# --- Weather / river gauge feeds (replace the sensor simulator) ---
WEATHER_API_KEY=your-weather-api-key
RIVER_GAUGE_FEED_URL=https://gauges.example.invalid/feed
RIVER_GAUGE_API_KEY=your-river-gauge-api-key

# --- Optional: separate database for `./mvnw verify -Dapp.test.use-testcontainers=false` ---
TEST_DB_URL=jdbc:postgresql://localhost:5432/disaster_test
TEST_DB_USERNAME=disaster
TEST_DB_PASSWORD=change-me
